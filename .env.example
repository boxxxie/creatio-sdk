# Creatio Server Credentials & Live Test Configuration Example
CREATIO_BASE_URL=https://your-instance.creatio.com

# Option 1: Forms Authentication (username/password)
CREATIO_USERNAME=your_username
CREATIO_PASSWORD=your_password

# Option 2: OAuth 2.0 Client Credentials (Creatio Identity Service)
CREATIO_IDENTITY_URL=https://your-instance.creatio.com/identity
# Optional alias accepted if CREATIO_IDENTITY_URL is not set:
# CREATIO_IDENTITY_SERVICE_URL=https://your-instance.creatio.com/identity
CREATIO_CLIENT_ID=your_client_id
CREATIO_CLIENT_SECRET=your_client_secret

# Option 3: Pre-issued Bearer Token
# CREATIO_BEARER_TOKEN=your_bearer_token

# Safety & Live Integration Suite Defaults (`mix test --only live`)
CREATIO_READ_ONLY=true
CREATIO_LIVE_ENTITY=Contact
CREATIO_LIVE_ALLOW_MUTATIONS=false
CREATIO_LIVE_STRICT=false
